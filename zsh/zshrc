# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# ------------------------------------------------------------------- path ---

# Keep $PATH free of duplicates. Nested shells re-run this file and would
# otherwise grow it on every level.
typeset -U path PATH

# A missing directory on $PATH costs a stat on every command lookup, so add
# one only once it exists.
path_prepend() { [[ -d "$1" ]] && PATH="$1:$PATH"; }
path_append()  { [[ -d "$1" ]] && PATH="$PATH:$1"; }

path_prepend "$HOME/go/bin"
path_prepend "$HOME/.local/bin"
path_append  "/usr/local/go/bin"

# ---------------------------------------------------------------- options ---

# init zsh completion system compsys
autoload -Uz compinit
compinit

# disable automatic cd
unsetopt autocd

# ------------------------------------------------------------- oh-my-zsh ---

export ZSH="$HOME/.oh-my-zsh"

# oh-my-zsh reads ZSH_THEME and plugins while it loads. Set both first.
ZSH_THEME="powerlevel10k/powerlevel10k"
plugins=(git)

[[ -r "$ZSH/oh-my-zsh.sh" ]] && source "$ZSH/oh-my-zsh.sh"

# --------------------------------------------------------------- aliases ---

##### git aliases #####
alias gco="git checkout"
alias ga="git add"
alias gc="git commit -m"
alias gs="git status"
alias gp="git pull"
alias gP="git push"
alias gPf="git push --force-with-lease"
alias gl="git log --oneline"
alias gr="git rebase"

_rebase_default() {
	git fetch origin;
	DEFAULT_BRANCH=$(git symbolic-ref refs/remotes/origin/HEAD | sed 's|^refs/remotes/origin/||');
	git rebase origin/$DEFAULT_BRANCH;
}
alias grd="_rebase_default"
alias gf="git fetch"
alias gfo="git fetch origin"
##### end git aliases #####

##### misc aliases #####
alias c=claude
alias vim=nvim
alias v=vim
##### endmisc aliases #####

# ----------------------------------------------------------------- tools ---

# rust
[[ -r "$HOME/.cargo/env" ]] && source "$HOME/.cargo/env"

# node version manager
export NVM_DIR="$HOME/.nvm"
[[ -s "$NVM_DIR/nvm.sh" ]] && source "$NVM_DIR/nvm.sh"
[[ -s "$NVM_DIR/bash_completion" ]] && source "$NVM_DIR/bash_completion"

# mise. MISE_SHELL is set by an outer shell that already activated it.
if [[ -z "${MISE_SHELL:-}" && -x "$HOME/.local/bin/mise" ]]; then
  eval "$("$HOME/.local/bin/mise" activate zsh)"
fi
path_prepend "$HOME/.local/share/mise/shims"

# --------------------------------------------------------------- machine ---

# things that shouldn't be committed
[[ -r "$HOME/.secrets" ]] && source "$HOME/.secrets"

# local overrides
[[ -r "$HOME/.zshrc.local" ]] && source "$HOME/.zshrc.local"

# ---------------------------------------------------------------- prompt ---

# To customize prompt, run `p10k configure` or edit ~/.p10k.zsh.
[[ -r "$HOME/.p10k.zsh" ]] && source "$HOME/.p10k.zsh"

# zsh-syntax-highlighting wraps the line editor, so it must come last.
_zsh_hl="$HOME/.zsh-plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
[[ -r "$_zsh_hl" ]] && source "$_zsh_hl"
unset _zsh_hl
